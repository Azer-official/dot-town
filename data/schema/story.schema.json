{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dotgame/story.schema.json",
  "title": "DotGame 스토리/NPC 대사 (data/story/story.json) v1",
  "type": "object",
  "required": [
    "version",
    "is_sample",
    "characters"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "updated_at": {
      "type": "string"
    },
    "is_sample": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    },
    "player": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "characters": {
      "type": "object",
      "description": "키 = NPC id (game/js/map.js 의 DotGame.NPCS[].id): heroine, park_youngmi, jung_hyuna, jo_sunmi, lee_jin, kang_myeongheon",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "대화창 표시 이름. 첫 만남 전엔 '???' 권장"
          },
          "location": {
            "type": "string",
            "description": "기본 장소 (NPC 가 서 있는 곳). 이 장소의 장면은 NPC 에게 말 걸 때 재생"
          },
          "scenes": {
            "type": "array",
            "description": "위에서부터 조건을 만족하는 첫 장면 1개를 재생",
            "items": {
              "type": "object",
              "required": [
                "id",
                "lines"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "requires_flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "excludes_flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "set_flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/line"
                  }
                },
                "affection": {
                  "type": "number",
                  "description": "이 장면 재생 시 호감도 증감 (세이브 affection[캐릭터id])"
                },
                "late_lines": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/line"
                  },
                  "description": "available_from 보다 늦게 재생될 때 lines 대신 ('늦었지만…' 버전)"
                },
                "available_from": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "이 날짜(KST)부터 재생 가능. 지난 날짜에 못 본 장면은 밀린 이벤트로 하루 하나씩 풀림"
                },
                "available_until": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "이 날짜(KST)까지만 재생 (선택)"
                },
                "location": {
                  "type": "string",
                  "description": "장면 장소. 캐릭터 location 과 같거나 생략 → NPC 대화, 다른 건물 id → 그 건물 문에서 재생"
                },
                "door_mode": {
                  "enum": [
                    "instead",
                    "before"
                  ],
                  "description": "건물 장면: instead(기본) = 건물 기본 콘텐츠 대신, before = 장면 후 기본 콘텐츠"
                },
                "stage": {
                  "type": "string",
                  "description": "이 단계 이상일 때만 (단계 정의가 있을 때만 적용, 없으면 메타데이터)"
                },
                "repeatable": {
                  "type": "boolean",
                  "description": "true 면 재생 후에도 조건이 맞으면 다시 재생 (기본: 한 번)"
                },
                "event_id": {
                  "type": "string",
                  "description": "메타데이터 (게임은 무시)"
                },
                "note": {
                  "type": "string",
                  "description": "메타데이터 (게임은 무시)"
                },
                "key_event": {
                  "type": "boolean",
                  "description": "메타데이터: ★ 단계 전환 핵심 이벤트"
                },
                "kind": {
                  "type": "string",
                  "description": "장면 종류. 'ending' 이면 즉시 장면(밀린 이벤트 큐·stage·requires_flags 무시, available_from 이 되면 바로 재생)"
                },
                "type": {
                  "type": "string",
                  "description": "kind 와 같음 (별칭). 'ending' = 즉시 장면"
                },
                "bypass_backlog": {
                  "type": "boolean",
                  "description": "true = 즉시 장면 (kind 'ending' 과 같은 동작)"
                },
                "priority": {
                  "enum": [
                    "immediate",
                    "normal"
                  ],
                  "description": "'immediate' = 즉시 장면 (kind 'ending' 과 같은 동작)"
                }
              }
            }
          },
          "default_lines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "맞는 장면이 없을 때"
          },
          "stages": {
            "$ref": "#/$defs/stages"
          }
        }
      }
    },
    "affection_stages": {
      "type": "object",
      "description": "캐릭터 id → 호감도 단계 목록 (characters.<id>.stages 로 써도 됨)",
      "additionalProperties": {
        "$ref": "#/$defs/stages"
      }
    }
  },
  "$defs": {
    "simple_line": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "speaker": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "portrait": {
              "type": [
                "string",
                "null"
              ]
            },
            "narration": {
              "type": "boolean"
            },
            "emotion": {
              "type": "string"
            }
          }
        }
      ]
    },
    "line": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "speaker": {
              "type": "string",
              "description": "화자 이름. 공백뿐('　' 전각 공백 포함)이면 나레이션"
            },
            "text": {
              "type": "string"
            },
            "portrait": {
              "type": [
                "string",
                "null"
              ],
              "description": "초상화 id 직접 지정 (hero, heroine, park_youngmi …) / null = 초상화 없음. 생략 시 화자 이름으로 자동"
            },
            "narration": {
              "type": "boolean",
              "description": "true = 나레이션 (이름표·초상화 없음, 다른 스타일)"
            },
            "emotion": {
              "type": "string",
              "description": "표정 태그 (현재 게임은 표시하지 않음)"
            },
            "prompt": {
              "type": "string",
              "description": "선택지 줄: 선택지 위에 보일 질문/안내 (선택)"
            },
            "choices": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "description": "반응만 다른 선택지. 고른 뒤 그 반응 lines 를 보여 주고 장면은 똑같이 이어짐",
              "items": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$",
                    "description": "세이브 story.choices 에 기록되는 id (생략 시 a, b, c…)"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "description": "현수가 하는 말 (선택지 문구)"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/simple_line"
                    },
                    "description": "이 선택지의 반응 대사"
                  },
                  "set_flags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "affection": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "choices"
              ]
            }
          ]
        }
      ]
    },
    "stage": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "화면 알림에 쓰는 이름 (예: ② 스터디 메이트)"
        },
        "min_affection": {
          "type": "number",
          "description": "이 호감도 이상 (affection[캐릭터id])"
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "이 날짜(KST) 이후"
        },
        "requires_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "이 플래그가 모두 켜져야 함 (예: 전 단계 ★ 이벤트가 세팅하는 stage2_ready)"
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      },
      "description": "앞에서부터 조건을 모두 만족하는 데까지가 현재 단계. 세이브에 저장되고 내려가지 않음"
    }
  }
}
